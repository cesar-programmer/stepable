# Reference only. `pnpm env:start` generates ignored .env.local from the local stack.
# Never replace these placeholders with real values in this versioned file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
STEPABLE_APP_URL=http://127.0.0.1:3000
STEPABLE_MAILPIT_URL=http://127.0.0.1:54324

# Asistente (E3). Desactivado por defecto. Configurar en .env.development.local
# (ignorado por Git); nunca en este archivo ni en el código.
# Modos: desactivado | simulado (solo pruebas técnicas) | real
# STEPABLE_AI_CHAT_MODE=desactivado
# STEPABLE_AI_CHAT_PROVIDER=deepseek        # deepseek | openai
# STEPABLE_AI_CHAT_MODEL=nombre-exacto-del-modelo
# STEPABLE_AI_EMBEDDINGS_MODE=desactivado   # decisión independiente del chat
# STEPABLE_AI_EMBEDDINGS_PROVIDER=openai
# STEPABLE_AI_EMBEDDINGS_MODEL=nombre-exacto-del-modelo
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# RF-10: estimated AI consumption limits (defaults approved on 2026-10-06).
# The global total never resets by itself; daily limits reset at 00:00 UTC.
STEPABLE_AI_BUDGET_GLOBAL_USD=1
STEPABLE_AI_BUDGET_SPACE_DAILY_USD=0.20
STEPABLE_AI_USER_DAILY_QUERIES=40
