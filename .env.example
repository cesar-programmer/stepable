# Copy this file to .env.local after `pnpm env:start`.
# Obtain local URLs and keys with `pnpm env:status`; do not commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:54322/postgres
