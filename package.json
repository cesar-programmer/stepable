{
  "name": "stepable",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/with-local-supabase-env.mjs playwright test",
    "test:integration:auth": "node scripts/with-local-supabase-env.mjs vitest run --config vitest.integration.config.ts",
    "test:e2e:auth": "node scripts/with-local-supabase-env.mjs playwright test tests/e2e/auth.spec.ts",
    "auth:create-local-user": "node scripts/create-local-test-user.mjs",
    "env:network": "node scripts/ensure-local-network.mjs",
    "env:start": "pnpm env:network && supabase start --network-id stepable-local",
    "env:status": "supabase status",
    "env:stop": "supabase stop",
    "db:reset": "supabase db reset --network-id stepable-local",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.7",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
